# Скопируй этот файл в server/.env и заполни.
# server/.env в git не попадает (он в .gitignore). Никому его не показывай.

# Supabase: Project Settings -> API Keys -> Secret keys
SUPABASE_URL=https://fhzskhcxfkrmotmwkcwo.supabase.co
SUPABASE_SECRET_KEY=sb_secret_ВСТАВЬ_СЮДА

# Cloudflare R2: где хранить аудио (без лимита 50 МБ, качество 128 kbps)
R2_ACCOUNT_ID=ВСТАВЬ_ACCOUNT_ID
R2_ACCESS_KEY_ID=ВСТАВЬ_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=ВСТАВЬ_SECRET_ACCESS_KEY
R2_BUCKET=focusos-media

# Если YouTube пишет «Sign in to confirm you're not a bot» — раскомментируй:
# COOKIES_BROWSER=safari
